# 既定: リポジトリ内は LF で保存する
* text=auto eol=lf

# Windows 専用スクリプトは CRLF でチェックアウトする
*.ps1  text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf
*.cmd  text eol=crlf
*.bat  text eol=crlf

# バイナリは変換しない
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.mp4  binary
*.mp3  binary
*.wav  binary
*.woff binary
*.woff2 binary
*.zip  binary
