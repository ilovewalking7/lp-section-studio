# Dependencies
node_modules/
.venv/
venv/
__pycache__/
*.pyc

# Build output
dist/
dist-ssr/
*.tsbuildinfo

# Environment / secrets
.env
.env.local
.env.*.local

# OS / editor
.DS_Store
*.log

# Claude Code local (session-specific) settings — keep out of version control
.claude/settings.local.json

# 配信用レジストリ（npm run build / npm run registry で生成）
public/r/

# 静的HTMLは生成物なので git には入れない。
# ただし配信はする: ビルド時に scripts/emit-static-html.mjs が
# mcp/data/components.json（git 管理下）から public/html/ へ書き出す。
# ローカルで作り直す時だけ npm run html（Playwright を使う）。
public/html/

# BOOTH 配布用の ZIP と展開ディレクトリ（node scripts/build-release.mjs で作る）
release/
